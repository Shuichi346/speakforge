# ===========================================
# SpeakForge 設定ファイル（テンプレート）
# ===========================================

# ----- LM Studio設定 -----
# LM StudioのAPIエンドポイントURL
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# 使用するモデル名（LM Studioでロードしたモデルの識別子）
# 
# 【推奨モデル】Qwen3系
#   - qwen3-8b
#   - qwen3-vl-8b-instruct
#   - qwen3-14b
#   - qwen3-30b-a3b
#
# 【非推奨・未対応】
#   - Gemini系（応答形式が異なる）
#   - GPT系（ローカル非対応）
#
# 空の場合はLM Studioで現在ロード中のモデルを自動使用
LM_STUDIO_MODEL=qwen/qwen3-vl-8b

# ----- Whisper設定 -----
# モデル名: tiny, base, small, medium, large-v3-turbo
# 
# Apple Silicon推奨:
#   - M1/M2: base または small
#   - M3/M4: large-v3-turbo
#
WHISPER_MODEL=large-v3-turbo

# 認識言語（英語学習用なのでenを推奨）
WHISPER_LANGUAGE=en

# ----- TTS設定（Pocket TTS） -----
# テキスト読み上げ機能を有効にするか
TTS_ENABLED=true

# ボイス名（英語の読み上げに使用）
# 利用可能: alba, marius, javert, jean, fantine, cosette, eponine, azelma
# alba: 女性、落ち着いた声
# marius: 男性
# jean: 男性
# fantine: 女性
TTS_VOICE=alba

# TTS生成の温度パラメータ（0.0-1.0、高いほど変化が大きい）
TTS_TEMPERATURE=0.7

# ----- Gradio設定 -----
GRADIO_SERVER_PORT=7860

# trueにするとインターネット経由でアクセス可能な共有リンクを生成
GRADIO_SHARE=false

# ----- パス設定（オプション） -----
# 通常は変更不要
# DATA_DIR=data
# MODELS_DIR=models